# ==========================================================
# FinTwin AI - Environment configuration TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ==========================================================

# --- Application ---
APP_NAME=FinTwin AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_RELOAD=false

# Secret used to sign NiceGUI browser sessions.
# Generate a long random value (see docs/setup.md).
STORAGE_SECRET=replace-with-a-long-random-secret

# --- MongoDB ---
# Local MongoDB:            mongodb://localhost:27017
# Demo mode (no install):   mongomock://localhost   (in-memory, data is lost on restart)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=fintwin_ai

# --- AI / LLM (optional) ---
# Leave GEMINI_API_KEY empty to use the built-in offline analysis engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Uploads ---
MAX_UPLOAD_MB=10
